<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="InventarioVideojuegos.MainWindow" Title="Inventario de Videojuegos" Width="900" Height="530" Background="#F4F6F9"><Grid RowDefinitions="Auto,*,Auto" Margin="16"><Border Grid.Row="0" Background="#1E293B" CornerRadius="8" Padding="14" Margin="0,0,0,12"><TextBlock Text="GESTION DE INVENTARIO DE VIDEOJUEGOS" FontSize="17" FontWeight="Bold" Foreground="White"/></Border><Grid Grid.Row="1" ColumnDefinitions="310,*" Margin="0,0,0,12"><Border Grid.Column="0" Background="White" CornerRadius="8" Padding="12" Margin="0,0,12,0"><StackPanel Spacing="6"><TextBlock x:Name="TxtIdSeleccionado" Text="Modo: Nuevo registro" FontWeight="Bold"/><TextBlock Text="Titulo:"/><TextBox x:Name="TxtTitulo"/><TextBlock Text="Genero:"/><ComboBox x:Name="CmbGenero" HorizontalAlignment="Stretch"><ComboBoxItem Content="Accion"/><ComboBoxItem Content="Aventura"/><ComboBoxItem Content="RPG"/><ComboBoxItem Content="Shooter"/></ComboBox><TextBlock Text="Plataforma:"/><ComboBox x:Name="CmbPlataforma" HorizontalAlignment="Stretch"><ComboBoxItem Content="PC"/><ComboBoxItem Content="PlayStation 5"/><ComboBoxItem Content="PlayStation 4"/><ComboBoxItem Content="Xbox"/><ComboBoxItem Content="Nintendo Switch"/></ComboBox><TextBlock Text="Precio ($):"/><TextBox x:Name="TxtPrecio"/><TextBlock Text="Stock:"/><TextBox x:Name="TxtStock"/><StackPanel Orientation="Horizontal" Spacing="6" Margin="0,8,0,0"><Button Content="Guardar" Click="BtnGuardar_Click" Background="#16A34A" Foreground="White"/><Button Content="Actualizar" Click="BtnActualizar_Click" Background="#2563EB" Foreground="White"/><Button Content="Eliminar" Click="BtnEliminar_Click" Background="#DC2626" Foreground="White"/><Button Content="Limpiar" Click="BtnLimpiar_Click" Background="#64748B" Foreground="White"/></StackPanel></StackPanel></Border><Border Grid.Column="1" Background="White" CornerRadius="8" Padding="12"><Grid RowDefinitions="Auto,*"><TextBlock Grid.Row="0" x:Name="TxtContador" Text="Total: 0 registros" FontWeight="Bold" Margin="0,0,0,8"/><ListBox Grid.Row="1" x:Name="LstVideojuegos" SelectionChanged="LstVideojuegos_SelectionChanged"/></Grid></Border></Grid><Border Grid.Row="2" x:Name="BannerMensaje" Background="#E2E8F0" CornerRadius="6" Padding="10"><TextBlock x:Name="TxtMensaje" Text="Sistema listo. Base de datos SQLite conectada." FontWeight="SemiBold"/></Border></Grid></Window>
